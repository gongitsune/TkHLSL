<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IsRoslynComponent>true</IsRoslynComponent>
        <!-- This assembly must ship ONLY under analyzers/dotnet/cs, never under lib/ — lib/ would
             make it an ordinary compile-time reference and leak Microsoft.CodeAnalysis.CSharp as a
             dependency onto every consumer. IsRoslynComponent alone does not relocate a project's own
             output; IncludeBuildOutput=false plus the explicit Pack item below does. -->
        <IncludeBuildOutput>false</IncludeBuildOutput>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>TkHLSL.SourceGeneration</PackageId>
        <Version>0.1.0</Version>
        <Authors>keigo</Authors>
        <Description>Roslyn incremental source generator that reads Unity ComputeShader (.compute) files
            from AdditionalFiles and generates typed C# bindings — per-kernel resource setters,
            DispatchThreads/DispatchGroups, cbuffer member setters, and StructuredBuffer element
            structs — for types marked with [TkHLSL.Unity.ComputeShaderBinding]. Does not touch disk:
            every .compute/.hlsl/.cginc it reads must be a Roslyn AdditionalFile. See
            docs/IMPLEMENTATION_PLAN.md §9 Phase 9.</Description>
        <PackageTags>hlsl;compute-shader;unity;source-generator;roslyn</PackageTags>
        <DevelopmentDependency>true</DevelopmentDependency>
        <NoWarn>$(NoWarn);NU5128</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <!-- The oldest CSharp Workspaces version that has ForAttributeWithMetadataName. Unity 6's own
             Roslyn is newer than this, so building against the floor keeps the generator loadable
             there without forcing every consumer onto the latest compiler. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.1" PrivateAssets="all" />
        <PackageReference Include="PolySharp" Version="1.16.0">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\TkHLSL\TkHLSL.csproj" PrivateAssets="all" />
    </ItemGroup>

    <!-- An analyzer/generator NuGet package must ship its own dependencies alongside itself under
         analyzers/dotnet/cs — Roslyn's analyzer assembly loader does not perform a NuGet restore for
         an analyzer's transitive dependencies, it only looks next to the analyzer DLL. TkHLSL.dll
         (and, on netstandard2.0, its own System.Memory.dll dependency) must therefore be packed as
         content here, not left as an ordinary PackageReference/ProjectReference. -->
    <Target Name="AddTkHlslDependenciesToPackage" BeforeTargets="_GetPackageFiles">
        <ItemGroup>
            <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs"
                  Visible="false" />
            <None Include="$(OutputPath)TkHLSL.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
            <None Include="$(OutputPath)System.Memory.dll" Pack="true" PackagePath="analyzers/dotnet/cs"
                  Visible="false" Condition="Exists('$(OutputPath)System.Memory.dll')" />
        </ItemGroup>
    </Target>

</Project>
